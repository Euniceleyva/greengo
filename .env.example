NEXT_PUBLIC_SITE_URL=https://www.greengotransferscancun.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Solo servidor. Nunca usar el prefijo NEXT_PUBLIC_ para estas credenciales.
# En proyectos nuevos, usar la clave recomendada con prefijo sb_secret_.
SUPABASE_SECRET_KEY=sb_secret_your_server_key
# Compatibilidad opcional con proyectos que aún usan la clave heredada:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_your_production_or_test_token
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_secret

# PayPal Checkout: usar sandbox hasta completar las pruebas.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# El sistema completo de admin y conductor permanece oculto.
INTERNAL_SYSTEM_ENABLED=false
